# Copie ce fichier en .env et renseigne TOKEN_ENDPOINT.

# L'URL de token de ton agent Copilot Studio publie.
TOKEN_ENDPOINT=https://REMPLACE-MOI/copilotstudio/agenticruntime/botsbyschema/REMPLACE-MOI/directline/token?api-version=2022-03-01-preview

# Endpoint Direct Line regional. europe pour un environnement europeen.
DIRECTLINE_BASE=https://europe.directline.botframework.com/v3/directline

# Port d'ecoute local.
PORT=3000

# URL publique du pont, telle qu'elle sera vue par le client A2A.
# En local : http://localhost:3000
# Derriere un dev tunnel : https://xxxx-3000.euw.devtunnels.ms
PUBLIC_URL=http://localhost:3000

# Identite publiee dans l'agent card.
AGENT_NAME=Copilot Studio Bridge
AGENT_DESCRIPTION=Exposes a published Microsoft Copilot Studio agent as an A2A agent. Handles customer service conversations end to end.

# Delai maximum d'un tour, en millisecondes.
# 3 s sur un agent sans action, prevoir large des qu'il ecrit dans Dataverse.
TURN_TIMEOUT_MS=45000

# Intervalle entre deux lectures d'activites.
POLL_INTERVAL_MS=400

# Forme de la reponse a message/send : "task" ou "message".
# task  = objet Task en etat completed (choix par defaut, le plus compatible)
# message = Message nu, si le client de Volker attend ca
RESPONSE_SHAPE=task
